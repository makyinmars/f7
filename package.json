{
  "name": "f7-template",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vp dev",
    "build": "bun run check && bun run lingui:compile && vp build && bun run typecheck",
    "start": "bun .output/server/index.mjs",
    "check": "bun run lint && bun run fmt:check",
    "check:all": "bun run check && bun run typecheck",
    "ci:check": "bun run lint",
    "ci:format": "bun run fmt:check",
    "db:check": "bunx drizzle-kit check",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun ./src/db/migrate.ts",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:seed": "bun ./src/db/seed/main-seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:up": "drizzle-kit up",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "sso": "aws sso login --sso-session=engineering",
    "lingui:extract": "lingui extract --clean",
    "lingui:compile": "lingui compile"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@lingui/core": "^5.9.4",
    "@lingui/react": "^5.9.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-devtools": "^5.96.2",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/react-router-devtools": "^1.166.11",
    "@tanstack/react-router-ssr-query": "^1.166.10",
    "@tanstack/react-start": "^1.167.16",
    "@trpc/client": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@trpc/tanstack-react-query": "^11.16.0",
    "better-auth": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260311-beta",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "sonner": "^2.0.7",
    "sst": "^4.6.11",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^5.9.4",
    "@lingui/cli": "^5.9.4",
    "@lingui/vite-plugin": "^5.9.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/aws-lambda": "8.10.161",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "oxfmt": "^0.0.1",
    "oxlint": "^0.15.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "oxfmt",
      "oxlint"
    ]
  }
}
